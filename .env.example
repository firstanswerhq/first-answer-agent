# Copy to .env for local runs (never commit .env). Everything is optional: with no key the app runs in offline rules mode.
PORT=3000
VULTR_INFERENCE_KEY=
VULTR_INFERENCE_URL=https://api.vultrinference.com/v1
VULTR_INFERENCE_MODEL=glm-5.3-flash
# Which business the agent is set up for: a file name in config/profiles without .json (dental, salon, accounting, or your own copy)
BUSINESS_PROFILE=dental
# Optional: override the business name from the profile
# BUSINESS_NAME=
FOLLOWUP_SPEEDUP=60
# Set to 1 only when the app runs behind ONE reverse proxy (Caddy, nginx) so rate limits see each visitor's address. Default: off.
TRUST_PROXY=
# On the VM, setting DOMAIN in deploy/cloud-init.sh turns on Caddy HTTPS, binds the app to 127.0.0.1:8080 and sets TRUST_PROXY=1 for you.
# Let visitors switch between the shipped example businesses in the dashboard header (0 = off)
# PROFILE_SWITCHER=1
# Make one tiny test call to the model at start-up so /api/health can report modelVerified (0 = skip)
# PROBE_MODEL=1
# Optional demo-protection and budget knobs (defaults shown)
# INFERENCE_MAX_RUNS_PER_HOUR=120
# INFERENCE_MAX_RUNS_PER_IP_PER_HOUR=15
# LIVE_BOOKING_TTL_MINUTES=30
# MAX_LIVE_BOOKINGS=24
# MAX_BOOKINGS_PER_VISITOR=3
# EMERGENCY_HOLDS=0
